<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_intrastat_landed_costs_form" model="ir.ui.view">
        <field name="name">intrastat.landed.cost.form</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='valuation_adjustments']/field/list/field[@name='final_cost']"
                position="after"
            >
                <field name="intrastat_percent" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
