<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_type_form_inherit" model="ir.ui.view">
        <field name="name">view.picking.type.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="after">
                <group name="purchase_push_link">
                    <group string="Recepciones">
                        <field name="default_dest_location_usage" invisible="1" />
                        <field
                            name="qty_received_method"
                            invisible="default_dest_location_usage not in ['transit', 'customer']"
                        />
                    </group>
                    <group />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
