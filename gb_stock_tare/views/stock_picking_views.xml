<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campo tara en ficha de producto, dentro del grupo hortofrutícola -->
    <record id="view_product_template_tare" model="ir.ui.view">
        <field name="name">product.template.form.tare</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="gb_price_per_kg.view_product_template_form_price_per_kg"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_price_per_kg']" position="after">
                <field name="tare_per_unit" string="Tara por bulto (kg)"/>
            </xpath>
        </field>
    </record>

    <!-- Columnas en operaciones detalladas del albarán -->
    <record id="view_stock_move_line_tare_tree" model="ir.ui.view">
        <field name="name">stock.move.line.tare.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="package_qty" string="Bultos" optional="show"/>
                <field name="gross_weight" string="Bruto (kg)" optional="show"/>
                <field name="tare_per_unit" string="Tara/bulto" optional="hide"/>
                <field name="tare_weight" string="Tara (kg)" optional="show" readonly="1"/>
                <field name="net_weight" string="Neto (kg)" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Pestaña resumen de pesos en el albarán -->
    <record id="view_picking_form_tare" model="ir.ui.view">
        <field name="name">stock.picking.form.tare</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="after">
                <page string="Pesos" name="tare_summary"
                      invisible="not move_ids">
                    <group string="Totales por línea de movimiento">
                        <field name="move_ids" nolabel="1">
                            <list string="Resumen pesos" editable="bottom">
                                <field name="product_id" readonly="1"/>
                                <field name="product_uom_qty" readonly="1" string="Demanda"/>
                                <field name="gross_weight_total" string="Bruto (kg)" readonly="1"/>
                                <field name="tare_weight_total" string="Tara (kg)" readonly="1"/>
                                <field name="net_weight_total" string="Neto (kg)" readonly="1"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
