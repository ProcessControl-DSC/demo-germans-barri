<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="container_planning_view_form" model="ir.ui.view">
        <field name="name">container.planning.view.form</field>
        <field name="model">container.planning</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action2embarked"
                        invisible="state != 'draft'"
                        string="Embarcado"
                        type="object"
                        class="oe_highlight"
                        groups="base.group_user"
                    />
                    <button
                        name="action2onport"
                        invisible="state != 'embarked'"
                        string="En puerto"
                        type="object"
                        class="oe_highlight"
                        groups="base.group_user"
                    />
                    <button
                        name="action2dispatched"
                        invisible="state != 'onport'"
                        string="Despachado"
                        type="object"
                        class="oe_highlight"
                        groups="base.group_user"
                    />
                    <button
                        name="action2confirmed"
                        invisible="state != 'dispatched'"
                        string="Confirmado"
                        type="object"
                        class="oe_highlight"
                        groups="base.group_user"
                    />
                    <button
                        name="action2download"
                        invisible="state != 'confirmed'"
                        string="Descargado"
                        type="object"
                        class="oe_highlight"
                        groups="base.group_user"
                    />
                    <button
                        name="action_back2draft"
                        invisible="state not in ['embarked', 'onport', 'dispatched', 'confirmed', 'download', 'cancel']"
                        string="Volver a borrador"
                        type="object"
                        groups="base.group_user"
                    />
                    <button
                        name="action2cancel"
                        invisible="state not in ['embarked', 'onport', 'dispatched', 'confirmed', 'download']"
                        string="Cancelar"
                        type="object"
                        groups="base.group_user"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,embarked,onport,dispatched,confirmed,download"
                    />
                </header>
                <sheet>
                    <h1>
                        Contenedor
                        <field name="name" class="oe_inline" nolabel="1" />
                    </h1>
                    <group>
                        <group col="2">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="departure_date" />
                            <field name="arrival_date" />
                            <field name="date" />
                            <field name="priority" />
                            <field
                                name="picking_type_id"
                                options="{'no_create': True}"
                                readonly="state in ['confirmed', 'download']"
                            />
                        </group>
                        <group col="2">
                            <field name="real_packages" />
                            <field name="size_id" options="{'no_create': True}" />
                            <field name="product_quantity" readonly="1" />
                            <field name="volume" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos a tránsito">
                            <field
                                name="moves2transit_ids"
                                widget="many2many"
                                nolabel="1"
                            >
                                <tree>
                                    <field name="picking_id" optional="show" />
                                    <field name="product_id" optional="show" />
                                    <field name="product_uom_qty" sum="Total" />
                                    <field
                                        name="quantity"
                                        sum="Total"
                                        optional="hide"
                                    />
                                    <field name="purchase_id" optional="show" />
                                    <field name="origin_port" />
                                    <field name="location_id" column_invisible="1" />
                                    <field name="location_dest_id" optional="show" />
                                    <field name="create_date" column_invisible="1" />
                                    <field name="date_deadline" column_invisible="1" />
                                    <field name="state" optional="show" />
                                    <field name="usd_currency_id" column_invisible="1" />
                                    <field name="company_currency_id" column_invisible="1" />
                                    <field
                                        name="cost_usd"
                                        options="{'currency_field': 'usd_currency_id'}"
                                        optional="show"
                                        groups="purchase_container_v19.manage_container_costs"
                                    />
                                    <field
                                        name="cost_eur"
                                        options="{'currency_field': 'company_currency_id'}"
                                        optional="show"
                                        groups="purchase_container_v19.manage_container_costs"
                                    />
                                    <field
                                        name="transport_cost"
                                        options="{'currency_field': 'company_currency_id'}"
                                        optional="show"
                                        groups="purchase_container_v19.manage_container_costs"
                                    />
                                    <field
                                        name="customs_fees"
                                        options="{'currency_field': 'company_currency_id'}"
                                        optional="show"
                                        groups="purchase_container_v19.manage_container_costs"
                                    />
                                    <field
                                        name="total_cost"
                                        options="{'currency_field': 'company_currency_id'}"
                                        optional="show"
                                        groups="purchase_container_v19.manage_container_costs"
                                    />
                                    <field
                                        name="unit_cost"
                                        options="{'currency_field': 'company_currency_id'}"
                                        optional="show"
                                        groups="purchase_container_v19.manage_container_costs"
                                    />
                                </tree>
                            </field>
                            <group col="12">
                                <group colspan="8" />
                                <group colspan="4">
                                    <group
                                        class="oe_subtotal_footer oe_right"
                                        groups="purchase_container_v19.manage_container_costs"
                                    >
                                        <separator string="Costes" />
                                        <button
                                            string="Actualizar costes"
                                            name="action_update_cost"
                                            type="object"
                                            class="oe_link"
                                            colspan="2"
                                        />
                                        <field
                                            name="usd_currency_id"
                                            invisible="1"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="company_currency_id"
                                            invisible="1"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="transport_cost"
                                            colspan="2"
                                            class="oe_subtotal_footer_separator"
                                            widget="monetary"
                                            options="{'currency_field': 'company_currency_id'}"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            string="Tasa de cambio (1€)"
                                            colspan="2"
                                            name="currency_rate"
                                            widget="monetary"
                                            options="{'currency_field': 'company_currency_id'}"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="bank_expenses"
                                            colspan="2"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="cost_usd"
                                            colspan="2"
                                            class="oe_subtotal_footer_separator"
                                            widget="monetary"
                                            options="{'currency_field': 'usd_currency_id'}"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="cost_eur"
                                            colspan="2"
                                            widget="monetary"
                                            options="{'currency_field': 'company_currency_id'}"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="customs_fees"
                                            colspan="2"
                                            widget="monetary"
                                            options="{'currency_field': 'company_currency_id'}"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                        <field
                                            name="total_cost"
                                            colspan="2"
                                            class="oe_subtotal_footer_separator"
                                            widget="monetary"
                                            options="{'currency_field': 'company_currency_id'}"
                                            groups="purchase_container_v19.manage_container_costs"
                                        />
                                    </group>
                                </group>
                            </group>
                            <div class="clearfix" />
                        </page>
                        <page string="Productos a existencias">
                            <group col="1">
                                <button
                                    name="action_done_all"
                                    string="Transferir todos"
                                    type="object"
                                    groups="stock.group_stock_user"
                                    class="oe_highlight"
                                    help="Done"
                                />
                            </group>
                            <field
                                name="moves2stock_ids"
                                widget="many2many"
                                nolabel="1"
                            >
                                <tree>
                                    <field name="picking_id" optional="show" />
                                    <field name="product_id" optional="show" />
                                    <field
                                        name="product_uom_qty"
                                        sum="Total"
                                        optional="show"
                                    />
                                    <field name="purchase_id" optional="show" />
                                    <field name="location_id" column_invisible="1" />
                                    <field name="location_dest_id" optional="show" />
                                    <field name="create_date" column_invisible="1" />
                                    <field name="date_deadline" column_invisible="1" />
                                    <field name="state" optional="show" />
                                </tree>
                            </field>
                        </page>
                        <page string="Albaranes">
                            <separator string="Albaranes proveedor" />
                            <field name="picking_ids" widget="many2many" nolabel="1" />
                            <separator string="Albaranes regularización" />
                            <field
                                name="regularization_picking_ids"
                                widget="many2many"
                                nolabel="1"
                            />
                        </page>
                        <page string="Regularizaciones">
                            <field name="regularization_ids" nolabel="1">
                                <tree editable="top">
                                    <field
                                        name="product_id"
                                        options="{'no_create': True}"
                                        optional="show"
                                    />
                                    <field name="tracking" optional="show" />
                                    <field
                                        name="lot_id"
                                        invisible="tracking == 'none'"
                                        required="tracking != 'none'"
                                        groups="stock.group_production_lot"
                                        optional="show"
                                    />
                                    <field name="product_uom_qty" optional="show" />
                                    <field
                                        name="purchase_id"
                                        options="{'no_create': True}"
                                        optional="show"
                                    />
                                    <field name="note" optional="show" />
                                    <field name="purchase_line_id" column_invisible="1" />
                                    <field name="state" column_invisible="1" />
                                    <button
                                        name="action_done"
                                        type="object"
                                        icon="fa-arrow-right"
                                        title="Validar"
                                        invisible="state != 'draft'"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page string="Información adicional">
                            <group>
                                <group>
                                    <field name="ship_name" />
                                    <field
                                        name="shipping_partner_id"
                                        context="{'form_view_ref': 'purchase_container_v19.res_partner_container_form', 'default_type': 'shipping_company'}"
                                    />
                                    <field
                                        name="freight_forwarder_partner_id"
                                        context="{'form_view_ref': 'purchase_container_v19.res_partner_container_form', 'default_type': 'freight_forwarder'}"
                                    />
                                </group>
                                <group />
                            </group>
                            <separator string="Observaciones" />
                            <field
                                name="incidents"
                                nolabel="1"
                                placeholder="Observaciones..."
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="container_planning_view_tree" model="ir.ui.view">
        <field name="name">container.planning.view.tree</field>
        <field name="model">container.planning</field>
        <field name="arch" type="xml">
            <list decoration-warning="priority == 'high'">
                <field name="date" />
                <field name="name" />
                <field name="size_id" />
                <field name="real_packages" sum="Total bultos reales" />
                <field
                    name="usd_currency_id"
                    column_invisible="1"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="company_currency_id"
                    column_invisible="1"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="cost_usd"
                    options="{'currency_field': 'usd_currency_id'}"
                    optional="show"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="currency_rate"
                    optional="show"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="cost_eur"
                    options="{'currency_field': 'company_currency_id'}"
                    optional="show"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="transport_cost"
                    options="{'currency_field': 'company_currency_id'}"
                    optional="show"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="customs_fees"
                    options="{'currency_field': 'company_currency_id'}"
                    optional="show"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field
                    name="total_cost"
                    options="{'currency_field': 'company_currency_id'}"
                    optional="show"
                    groups="purchase_container_v19.manage_container_costs"
                />
                <field name="departure_date" />
                <field name="arrival_date" />
                <field name="state" />
                <field name="priority" column_invisible="1" />
                <field name="incidents" />
            </list>
        </field>
    </record>
    <record id="container_planning_view_search" model="ir.ui.view">
        <field name="name">container.planning.view.search</field>
        <field name="model">container.planning</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="product_id" />
                <field name="purchase_id" />
                <field name="date" />
                <field name="departure_date" />
                <field name="arrival_date" />
                <separator />
                <filter
                    name="embarked"
                    string="Embarcado"
                    domain="[('state', '=', 'embarked')]"
                />
                <filter
                    name="dispatched"
                    string="Despachado"
                    domain="[('state', '=', 'dispatched')]"
                />
                <filter
                    name="confirmed"
                    string="Confirmado"
                    domain="[('state', '=', 'confirmed')]"
                />
                <group name="group_by" expand="1" string="Agrupar por">
                    <filter
                        name="group_name"
                        string="Contenedor"
                        domain="[]"
                        context="{'group_by': 'name'}"
                    />
                    <filter
                        name="group_state"
                        string="Estado"
                        domain="[]"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_arrival_date"
                        string="Fecha llegada"
                        domain="[]"
                        context="{'group_by': 'arrival_date'}"
                    />
                    <filter
                        name="group_departure_date"
                        string="Fecha salida"
                        domain="[]"
                        context="{'group_by': 'departure_date'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_container_planning" model="ir.actions.act_window">
        <field name="name">Planificación contenedores</field>
        <field name="res_model">container.planning</field>
    </record>
    <menuitem
        id="purchase_container_menu"
        name="Contenedores"
        parent="purchase.menu_purchase_root"
        sequence="2"
    />
    <menuitem
        id="container_planning_actions"
        action="action_container_planning"
        parent="purchase_container_menu"
        sequence="2"
    />
</odoo>
