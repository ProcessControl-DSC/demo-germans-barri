<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_price_per_kg" model="ir.ui.view">
        <field name="name">product.template.form.price.per.kg</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='traceability']" position="before">
                <group string="Configuración hortofrutícola" name="gb_config" invisible="type == 'service'">
                    <field name="show_price_per_kg" string="Mostrar Precio/kg en ventas"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
