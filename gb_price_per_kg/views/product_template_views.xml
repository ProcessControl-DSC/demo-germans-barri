<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_price_per_kg" model="ir.ui.view">
        <field name="name">product.template.form.price.per.kg</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='weight']" position="after">
                <separator string="Configuración hortofrutícola"/>
                <field name="show_price_per_kg"
                       string="Mostrar Precio/kg en ventas"
                       invisible="type == 'service'"
                       help="Muestra una columna con el precio equivalente por kilogramo en presupuestos, pedidos de venta y albaranes."/>
            </xpath>
        </field>
    </record>
</odoo>
