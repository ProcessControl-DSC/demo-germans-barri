<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_price_per_kg" model="ir.ui.view">
        <field name="name">stock.move.line.price.per.kg</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="price_per_kg_move" string="Precio/kg" optional="show"
                       decoration-muted="price_per_kg_move == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
